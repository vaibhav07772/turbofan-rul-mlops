# === Environment ===
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# === App ===
APP_NAME=Turbofan RUL MLOps
APP_VERSION=0.1.0

# === Uploads ===
MAX_UPLOAD_BYTES=52428800
ALLOWED_EXTENSIONS=.csv,.txt

# === MLflow ===
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_LOCATION=./mlruns
MLFLOW_EXPERIMENT_NAME=turbofan-rul
MLFLOW_REGISTERED_MODEL_NAME=turbofan-rul-model
MLFLOW_AUTO_REGISTER=true